digraph G {
  graph [rankdir=TB, fontname="DejaVu Sans", nodesep=0.25, ranksep=0.32, dpi=160, bgcolor=white];
  node  [fontname="DejaVu Sans", fontsize=11, style=filled, fillcolor="#FFFFFF", color="#333333"];
  edge  [fontname="DejaVu Sans", fontsize=10, color="#333333"];

  ini  [label="INICIO", shape=oval, fillcolor="#D9EAD3"];
  car  [label="Cargar expedientes desde expedientes.txt\n(si el archivo existe)", shape=box];
  mos  [label="Mostrar los expedientes en la tabla", shape=parallelogram];
  esp  [label="Esperar una acción del usuario", shape=parallelogram];
  op   [label="¿Qué botón\npresionó?", shape=diamond, fillcolor="#FFF2CC"];
  o1   [label="Registrar\n(Figura 4)", shape=box, fillcolor="#DDEBF7"];
  o2   [label="Buscar por\ncódigo", shape=box, fillcolor="#DDEBF7"];
  o3   [label="Mostrar\ntodos", shape=box, fillcolor="#DDEBF7"];
  o4   [label="Ordenar\npor código", shape=box, fillcolor="#DDEBF7"];
  o0   [label="Cerrar la\nventana", shape=box, fillcolor="#F4CCCC"];
  ret  [label="Actualizar la tabla y volver a esperar", shape=box, style="rounded,filled", fillcolor="#EEEEEE"];
  fin  [label="FIN", shape=oval, fillcolor="#F4CCCC"];

  ini -> car -> mos -> esp -> op;
  op -> o1 [label="Registrar"]; op -> o2 [label="Buscar"]; op -> o3 [label="Todos"];
  op -> o4 [label="Ordenar"]; op -> o0 [label="Cerrar"];
  {o1 o2 o3 o4} -> ret;
  ret -> esp [constraint=false, label=" repetir", color="#666666"];
  o0 -> fin;
  {rank=same; o1; o2; o3; o4; o0}
}
