digraph R {
  graph [rankdir=TB, fontname="DejaVu Sans", nodesep=0.3, ranksep=0.22, dpi=160, bgcolor=white];
  node  [fontname="DejaVu Sans", fontsize=11, style=filled, fillcolor="#FFFFFF", color="#333333"];
  edge  [fontname="DejaVu Sans", fontsize=10, color="#333333"];

  ini [label="Clic en Registrar expediente", shape=oval, fillcolor="#D9EAD3"];
  leer[label="Leer código, ciudadano, tipo,\nfecha y asunto del formulario", shape=parallelogram];
  val [label="ValidarDatos():\ncódigo (formato y duplicado), ciudadano,\ntipo, fecha y asunto", shape=box, fillcolor="#DDEBF7"];
  ok  [label="¿Todos los datos\nson válidos?", shape=diamond, fillcolor="#FFF2CC"];
  err [label="Mostrar aviso y colocar el cursor\nen el campo incorrecto", shape=parallelogram];
  lle [label="¿Hay espacio en\nlos arreglos (500)?", shape=diamond, fillcolor="#FFF2CC"];
  msg [label="Mostrar aviso\n«almacén lleno»", shape=parallelogram];
  agr [label="Agregar los datos a los\narreglos paralelos (Cantidad + 1)", shape=box, fillcolor="#DDEBF7"];
  gua [label="GuardarArchivo()", shape=box, fillcolor="#DDEBF7"];
  tab [label="MostrarExpedientes() y LimpiarCampos()", shape=box, fillcolor="#DDEBF7"];
  sal [label="Mostrar mensaje de registro exitoso", shape=parallelogram];
  fin [label="FIN del evento", shape=oval, fillcolor="#F4CCCC"];

  ini -> leer -> val -> ok;
  ok -> err [label=" No"];
  ok -> lle [label=" Sí"];
  lle -> msg [label=" No"];
  lle -> agr [label=" Sí"];
  agr -> gua -> tab -> sal -> fin;
  err -> fin; msg -> fin;
  {rank=same; ok; err}
  {rank=same; lle; msg}
}
